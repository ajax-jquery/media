  enableScroll();
  _playAudio();
  jQuery("#cover").animate({ opacity: 0, top: "-100%"}, 1500);
  showAllSect();
    jQuery("#cover").hide(1500,function(){
        //jQuery("#ytSound").animate({ bottom: "0px"}, 4000);
